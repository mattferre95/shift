{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum surface required by the SHIFT main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path"
  ]
}
