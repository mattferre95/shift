{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHIFT",
  "version": "1.1.1",
  "identifier": "com.shift.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SHIFT",
        "width": 980,
        "height": 680,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#06070B",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/128x128.png", "icons/32x32.png"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "binaries/ytdlp/": "ytdlp/" },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "Utility",
    "copyright": "SHIFT",
    "shortDescription": "Anything in. Anything out.",
    "longDescription": "A local-first Mac utility for downloading, clipping, converting, trimming and extracting media."
  }
}
